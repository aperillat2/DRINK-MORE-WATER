    "Change how much water gets added each time by adjusting the %@ value." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Passe den Wert „%@“ an, um festzulegen, wie viel Wasser jedes Mal hinzugefügt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cambia la cantidad de agua que se añade cada vez ajustando el valor de %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Modifiez la quantité d’eau ajoutée à chaque fois en ajustant la valeur %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Modifica la quantità d’acqua aggiunta ogni volta regolando il valore %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@”の値を調整すると、毎回追加される水の量を変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "‘%@’ 값을 조절하여 매번 추가되는 물의 양을 변경하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ajuste o valor %@ para alterar a quantidade de água adicionada a cada vez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "调整“%@”数值，即可更改每次添加的水量。"
          }
        }
      }
    },
